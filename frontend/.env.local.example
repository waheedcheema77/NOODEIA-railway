# Supabase - Authentication Only
# Get from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Neo4j AuraDB - All Data Storage
# Get from: https://console.neo4j.io/
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here

# Pusher - Real-time Messaging (Optional)
# Get from: https://dashboard.pusher.com/
# Leave empty to disable real-time features
PUSHER_APP_ID=your-app-id
PUSHER_SECRET=your-secret
NEXT_PUBLIC_PUSHER_KEY=your-key
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# Google Gemini API
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Tavily API - For Deep Research
# Get from: https://tavily.com/
TAVILY_API_KEY=your_tavily_key_here

# Google Custom Search API - For web search
# Get from: https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here
